{
  "name": "@naylabs/agent-lens",
  "version": "0.1.1",
  "description": "Figma-style visual review canvas designed for AI coding agents. Inspect, pin, comment, and copy structured execution prompts.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "type": "commonjs",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node -e \"require('fs').copyFileSync('dist/index.d.ts', 'dist/index.d.mts')\"",
    "preview": "vite preview",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Skn1999/agent-lens.git"
  },
  "keywords": [
    "ai",
    "devtools",
    "agent",
    "visual-feedback",
    "figma",
    "react",
    "review",
    "annotation",
    "prompt-engineering"
  ],
  "homepage": "https://github.com/Skn1999/agent-lens#readme",
  "bugs": {
    "url": "https://github.com/Skn1999/agent-lens/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "Sumit Nayyar",
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^5.1.2"
  }
}
